{
  "manifest_version": 3,
  "name": "Optima Time Machine",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "description": "YouTube frozen in the year you pick: old videos only, on the homepage, in the sidebar and in search. No account, no tracking.",
  "author": "optima machina",
  "homepage_url": "https://optimamachina.world/shelf/#optima-time-machine",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "idle",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://generativelanguage.googleapis.com https://api.anthropic.com; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN",
      "js": [
        "src/shared/dates.js",
        "src/shared/extract.js",
        "src/inject/interceptor.js"
      ]
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "js": ["src/content/bridge.js"]
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": ["src/content/feed.js"],
      "css": ["src/content/feed.css"]
    }
  ],
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Optima Time Machine",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
